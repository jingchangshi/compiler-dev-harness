  "storyline": [
    {
      "position": 1,
      "role": "整体问题",
      "claim": "A5 RegBase 目标要求 elementwise 计算以向量指令跑在对齐的 UB buffer 上,而前端给的是带 reshape 噪声的多维 tensor 链——这条 pipeline 就是两者之间的差距",
      "dossier_section": "mental_model",
      "evidence_refs": [
        "SYS-EV-014"
      ]
    },
    {
      "position": 2,
      "role": "系统心智模型",
      "claim": "normalize → vectorize → merge → bufferize → merge → align:每一级把上一级的输出表示加工成下一级的输入表示",
      "dossier_section": "mechanism",
      "evidence_refs": [
        "SYS-EV-001",
        "SYS-EV-002",
        "SYS-EV-003",
        "SYS-EV-004"
      ]
    },
    {
      "position": 3,
      "role": "端到端 transformation map",
      "claim": "六个 requested pass 加五个 context 阶段的完整管线图——谁在哪里被谁调用、条件门在哪",
      "dossier_section": "mechanism.stages",
      "evidence_refs": [
        "SYS-EV-001",
        "SYS-EV-002",
        "SYS-EV-003",
        "SYS-EV-004",
        "SYS-EV-009"
      ]
    },
    {
      "position": 4,
      "role": "规范化阶段的角色与契约",
      "claim": "PropagateReshape 先滑走 reshape 障碍,FlattenOps 再把 elementwise 链压成 1-D——向量器拿到的是平坦的 last-axis 域;两个 pass 的顺序是源码钉死的",
      "dossier_section": "contracts",
      "evidence_refs": [
        "SYS-EV-001",
        "SYS-EV-002",
        "reshape::EV-015",
        "flatten::EV-019"
      ]
    },
    {
      "position": 5,
      "role": "向量化建立 VF 单元",
      "claim": "AutoVectorizeV2 + OutlineVectorFunction 产出 hivm.vector_function 标注的 callees——这个 attr 就是 MergeVecScope 认领合并对象的全部依据(真实执行帧:outlined_vf_0/1/2)",
      "dossier_section": "contracts",
      "evidence_refs": [
        "SYS-EV-012",
        "av2::EV-015",
        "mergevecscope::EV-002"
      ]
    },
    {
      "position": 6,
      "role": "关键表示边界与 VF 粒度决策",
      "claim": "tensor→memref 是全链最大的表示边界;MergeVecScope 围绕它有两个互斥位置(L1 前/L2 后),取舍由 enableVfMergeLevel 编码",
      "dossier_section": "decisions",
      "evidence_refs": [
        "SYS-EV-003",
        "mergevecscope::EV-022"
      ]
    },
    {
      "position": 7,
