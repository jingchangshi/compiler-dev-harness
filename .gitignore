cases/
# Runtime auto-observation of the knowledge loop (non-sensitive JSONL, per
# adapters/compiler-dev/feedback-schema.md v2 / ADR-025). Curated feedback
# artifacts stay committed; these streams do not.
analysis/feedback/queries/
analysis/feedback/routes/
# Generic-context backend stream (compiler_inspect, Phase R1): counts and
# durations only — no prompts, task text, source bodies, or raw tool output.
analysis/feedback/context/
# Automatic candidate feedback awaits human review via scripts/review-feedback.mjs.
analysis/feedback/candidates/

# Runtime explanation workflow store (Phase T4): normal-use explanation bundles,
# presentations, and run state. Gitignored by design — normal use never dirties
# the tracked harness tree. Curated fixtures stay in analysis/explanations/ and
# analysis/presentations/ and are promoted by explicit developer action only.
analysis/

# Python bytecode cache
__pycache__/
